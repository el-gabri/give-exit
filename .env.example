# Give Exit local configuration. The historical LITIGATION_ prefix is retained
# for backward compatibility.

# --- Document-security LLM ---
# Balanced prompt-injection review uses this provider for bounded suspicious excerpts.
LITIGATION_LLM_PROVIDER=openai
LITIGATION_OPENAI_API_KEY=<your-openai-api-key>
LITIGATION_LLM_MODEL=gpt-4o-mini

LITIGATION_NOTICE_COMPOSER=openai
LITIGATION_NOTICE_COMPOSER_MODEL=gpt-5.6-terra
LITIGATION_NOTICE_COMPOSER_REASONING_EFFORT=low
LITIGATION_NOTICE_COMPOSER_MAX_OUTPUT_TOKENS=1200

# --- JUÁ embeddings ---
LITIGATION_EMBEDDING_PROVIDER=sentence_transformers
LITIGATION_EMBEDDING_MODEL=ufca-llms/jua-4B-mixed
LITIGATION_EMBEDDING_MODEL_REVISION=57f491c1718171c0ad71d723c4f6b2030684c4eb
LITIGATION_EMBEDDING_EXPECTED_DIMENSIONS=2560
LITIGATION_EMBEDDING_REQUIRE_MODEL_REVISION=true
LITIGATION_EMBEDDING_QUERY_INSTRUCTION=Instruct: Dada uma consulta jurídica brasileira, recupere os trechos ou dispositivos legais vigentes mais relevantes. Query:
LITIGATION_EMBEDDING_DEVICE=cpu
# Keep this small for large legal models such as JUÁ 4B; raise only after
# measuring available CPU/GPU memory.
LITIGATION_EMBEDDING_BATCH_SIZE=2
LITIGATION_EMBEDDING_INDEX_SHARD_SIZE=25
LITIGATION_EMBEDDING_QUERY_TIMEOUT_SECONDS=300
# How long an overlapping request waits for the single embedding slot
# before retrieval degrades to lexical-only. With one slow local model,
# concurrent users are normal, so this must be a queue and not a
# near-instant rejection.
LITIGATION_EMBEDDING_QUERY_QUEUE_TIMEOUT_SECONDS=120

# Docker build extras required by the configured OCR, PostgreSQL and JUÁ stack.
LITIGATION_API_EXTRAS=ocr,postgres,local-embeddings

# Local Python connects through localhost. Compose overrides this setting with
# the Docker-specific DSN below.
LITIGATION_VECTOR_STORE=postgres
LITIGATION_POSTGRES_DSN=postgresql://postgres:giveexit@localhost:5432/postgres
LITIGATION_DOCKER_POSTGRES_DSN=postgresql://postgres:giveexit@host.docker.internal:5432/postgres
# --- Storage ---
# Reject PDFs larger than this page count before extraction/OCR.
LITIGATION_MAX_DOCUMENT_PAGES=250
# Largest accepted evidence upload. Enforced as an ASGI body limit before the
# server buffers the request, and again while streaming the decoded file.
LITIGATION_MAX_UPLOAD_BYTES=20971520

# --- In-process case retention ---
# Cases live in this process's memory, so these bounds are also DoS controls.
# A full store refuses new cases rather than evicting a live one.
LITIGATION_MAX_ACTIVE_CASES=500
LITIGATION_MAX_DOCUMENTS_PER_CASE=20
LITIGATION_MAX_MESSAGES_PER_CASE=200
LITIGATION_MAX_IDEMPOTENCY_KEYS_PER_CASE=50
# Idle cases and their evidence vectors are reclaimed after this long.
LITIGATION_CASE_IDLE_TTL_SECONDS=86400
LITIGATION_CASE_SWEEP_INTERVAL_SECONDS=300
# Startup deletes evidence vectors with no live case. Safe only when this
# process owns the vector-store namespace. Set false for multiple workers or
# replicas sharing one PostgreSQL/Chroma namespace, or each start deletes the
# others' live case evidence.
LITIGATION_PURGE_ORPHANED_EVIDENCE_ON_STARTUP=true

# --- RAG ---
# Number of ranked chunks retained per agent query before deduplication and
# context-size filtering. Retrieval audits record the effective value.
LITIGATION_RETRIEVAL_K=6
# Hybrid combines dense and backend lexical rankings with deterministic
# reciprocal-rank fusion.
LITIGATION_RETRIEVAL_MODE=hybrid
LITIGATION_RETRIEVAL_CANDIDATE_MULTIPLIER=4
LITIGATION_RETRIEVAL_RRF_CONSTANT=60
LITIGATION_RETRIEVAL_DENSE_WEIGHT=1.0
LITIGATION_RETRIEVAL_LEXICAL_WEIGHT=1.0
# Optional second stage; model settings are needed only when this is enabled.
LITIGATION_RERANKER_PROVIDER=none
# LITIGATION_RERANKER_PROVIDER=sentence_transformers
# LITIGATION_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# LITIGATION_RERANKER_BATCH_SIZE=8
# LITIGATION_RERANKER_MODEL_REVISION=<commit-sha>
# LITIGATION_RERANKER_DEVICE=cpu
# Persisting excerpts expands the sensitive-data footprint. Keep disabled unless
# an explicit access-control and retention policy covers the JSONL run history.
LITIGATION_RETRIEVAL_TRACE_INCLUDE_PREVIEWS=false

# --- Document security ---
# "rules" runs deterministic bilingual checks only. "balanced" (default)
# asks the LLM to classify bounded suspicious excerpts. "strict" reviews all
# page text semantically and can add significant latency/cost.
LITIGATION_PROMPT_INJECTION_SCAN_MODE=balanced
# Strict-mode cost guards. Exceeding either limit fails closed.
LITIGATION_PROMPT_INJECTION_STRICT_MAX_CHARS=500000
LITIGATION_PROMPT_INJECTION_STRICT_MAX_BATCHES=64

# --- API access controls ---
# Per-client, per-minute ceilings. 0 disables an individual limiter.
LITIGATION_CASE_RATE_LIMIT_PER_MINUTE=30
LITIGATION_MESSAGE_RATE_LIMIT_PER_MINUTE=60
LITIGATION_UPLOAD_RATE_LIMIT_PER_MINUTE=20
# Notice generation is the most expensive route (embeddings, retrieval, LLM).
LITIGATION_NOTICE_RATE_LIMIT_PER_MINUTE=10
# Reverse proxies in front of the API. 0 ignores X-Forwarded-For and uses the
# socket peer. Behind a proxy this MUST match the real hop count, otherwise
# every caller shares one rate-limit bucket.
LITIGATION_TRUSTED_PROXY_HOPS=0

# --- Logging ---
LITIGATION_LOG_LEVEL=INFO

HF_TOKEN=<your_huggind_face_token>