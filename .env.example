# Copy to .env and fill in. Runtime variables retain the LITIGATION_ prefix for
# backward compatibility even though Give Exit is now Consumer-only.

# --- LLM used only by bounded document-security review ---
# A fresh clone runs offline. Select openai, anthropic or gemini for semantic
# prompt-injection review; deterministic rules still scan every document.
LITIGATION_LLM_PROVIDER=mock
# LITIGATION_OPENAI_API_KEY=sk-...
# LITIGATION_ANTHROPIC_API_KEY=sk-ant-...
# LITIGATION_GEMINI_API_KEY=...
# LITIGATION_LLM_MODEL=...
LITIGATION_LLM_MAX_OUTPUT_TOKENS=8192
LITIGATION_LLM_RETRY_MAX_ATTEMPTS=3

# --- Optional AI prose composer for the final consumer notice ---
# It sends only the confirmed case packet (facts, selected evidence excerpts
# and already-filtered legal grounds) to OpenAI. Citations, legal selection,
# requests and monetary calculation remain deterministic in this application.
# The default is offline/deterministic. When enabled, GPT-5.6 Terra uses the
# Responses API with strict Structured Outputs and low reasoning effort.
LITIGATION_NOTICE_COMPOSER=deterministic
# LITIGATION_NOTICE_COMPOSER=openai
# LITIGATION_NOTICE_COMPOSER_MODEL=gpt-5.6-terra
# LITIGATION_NOTICE_COMPOSER_REASONING_EFFORT=low
# LITIGATION_NOTICE_COMPOSER_MAX_OUTPUT_TOKENS=1200
# Maximum time the local Streamlit client waits for notice generation. This is
# intentionally longer than the first JUÁ 4B load on CPU. It affects only the
# frontend request; query-level embedding safeguards remain configured below.
LITIGATION_NOTICE_REQUEST_TIMEOUT_SECONDS=1200

# --- Embeddings ---
# AUTO selects mock embeddings offline, the native embedding API for OpenAI or
# Gemini, and local BGE-M3 for Anthropic.
LITIGATION_EMBEDDING_PROVIDER=auto
# LITIGATION_EMBEDDING_MODEL=...
# LITIGATION_GEMINI_EMBEDDING_DIMENSIONS=768
# LITIGATION_EMBEDDING_MODEL_REVISION=<commit-sha>
# LITIGATION_EMBEDDING_DEVICE=cpu
# Start conservatively for a 4B local model on CPU; benchmark 1, 2 and 4 on
# the deployment hardware before increasing it.
LITIGATION_EMBEDDING_BATCH_SIZE=2

# Brazilian legal JUÁ bake-off (install .[local-embeddings]):
# LITIGATION_EMBEDDING_PROVIDER=sentence_transformers
# LITIGATION_EMBEDDING_MODEL=ufca-llms/jua-4B-mixed
# Pin the exact model commit. The current JUÁ snapshot emits 2560 dimensions.
# LITIGATION_EMBEDDING_MODEL_REVISION=57f491c1718171c0ad71d723c4f6b2030684c4eb
# LITIGATION_EMBEDDING_EXPECTED_DIMENSIONS=2560
# LITIGATION_EMBEDDING_REQUIRE_MODEL_REVISION=true
# LITIGATION_EMBEDDING_QUERY_INSTRUCTION=Instruct: Dada uma consulta jurídica brasileira, recupere os trechos ou dispositivos legais vigentes mais relevantes. Query:
# LITIGATION_EMBEDDING_DEVICE=cpu
# LITIGATION_EMBEDDING_BATCH_SIZE=2
# LITIGATION_EMBEDDING_INDEX_SHARD_SIZE=25
# Query-time safeguards. A hybrid request falls back to audited Portuguese
# full-text search if the semantic dependency times out or opens its circuit.
# Large local models on CPU may need 300 seconds; hosted providers should use
# a much smaller timeout such as 30 seconds.
LITIGATION_EMBEDDING_QUERY_TIMEOUT_SECONDS=30
LITIGATION_EMBEDDING_QUERY_MAX_CONCURRENCY=1
LITIGATION_EMBEDDING_CIRCUIT_BREAKER_FAILURES=2
LITIGATION_EMBEDDING_CIRCUIT_BREAKER_RESET_SECONDS=60
LITIGATION_EMBEDDING_QUERY_CACHE_TTL_SECONDS=300
LITIGATION_EMBEDDING_QUERY_CACHE_MAX_ENTRIES=256
LITIGATION_EMBEDDING_LEXICAL_FALLBACK=true
# After changing the corpus, embedding model or revision, materialize its
# versioned legal index before serving notice-generation requests:
# python -m app.consumer.preindex_legal

# Docker build extras. The default is enough for Chroma + mock/OpenAI embeddings.
# PostgreSQL + JUÁ requires: ocr,postgres,local-embeddings
LITIGATION_API_EXTRAS=ocr

# --- Storage and ingestion ---
LITIGATION_DATA_DIR=./data
# chroma keeps vectors under LITIGATION_DATA_DIR. postgres stores vectors in
# the database below; pgvector must first be enabled with CREATE EXTENSION vector.
LITIGATION_VECTOR_STORE=chroma
# Local Python process:
# LITIGATION_POSTGRES_DSN=postgresql://give_exit:password@localhost:5432/give_exit
# API in Docker Desktop, with PostgreSQL running on the Windows host:
# LITIGATION_POSTGRES_DSN=postgresql://give_exit:password@host.docker.internal:5432/give_exit
# To move an existing Chroma corpus without recalculating its embeddings:
# python -m app.consumer.migrate_legal_index_to_postgres
# Then change LITIGATION_VECTOR_STORE=postgres and run:
# python -m app.consumer.preindex_legal --check
LITIGATION_MAX_DOCUMENT_PAGES=250

# --- Consumer RAG ---
LITIGATION_RETRIEVAL_K=6
LITIGATION_RETRIEVAL_MODE=hybrid
LITIGATION_RETRIEVAL_CANDIDATE_MULTIPLIER=4
LITIGATION_RETRIEVAL_RRF_CONSTANT=60
LITIGATION_RETRIEVAL_DENSE_WEIGHT=1.0
LITIGATION_RETRIEVAL_LEXICAL_WEIGHT=1.0
# The Consumer legal corpus derives its immutable version automatically.
LITIGATION_RERANKER_PROVIDER=none
# To enable a local second stage:
# LITIGATION_RERANKER_PROVIDER=sentence_transformers
# LITIGATION_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# LITIGATION_RERANKER_BATCH_SIZE=8
# LITIGATION_RERANKER_MODEL_REVISION=<commit-sha>
# LITIGATION_RERANKER_DEVICE=cpu
LITIGATION_RETRIEVAL_TRACE_INCLUDE_PREVIEWS=false

# --- Untrusted-document security ---
LITIGATION_PROMPT_INJECTION_SCAN_MODE=balanced
LITIGATION_PROMPT_INJECTION_STRICT_MAX_CHARS=500000
LITIGATION_PROMPT_INJECTION_STRICT_MAX_BATCHES=64

# --- API ---
LITIGATION_DEPLOYMENT_MODE=local
LITIGATION_CORS_ALLOW_ORIGINS=http://localhost:8501
# Mandatory for production and every deployment reachable beyond localhost.
# LITIGATION_API_AUTH_KEY=change-me
LITIGATION_UPLOAD_RATE_LIMIT_PER_MINUTE=20

# --- Logging and privacy ---
LITIGATION_LOG_LEVEL=INFO
# Stable privacy-safe references require a secret-manager-backed HMAC key.
# LITIGATION_TELEMETRY_PSEUDONYM_KEY=generate-a-long-random-secret

# --- DataJud ---
# Public key published by CNJ: https://datajud-wiki.cnj.jus.br/api-publica/acesso/
# Sent as header: "Authorization: APIKey <key>"
LITIGATION_DATAJUD_API_KEY=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==
LITIGATION_DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br
