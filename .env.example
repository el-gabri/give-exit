# Copy to .env and fill in. All variables are prefixed LITIGATION_.

# --- LLM provider ---
# A fresh clone deliberately runs offline. Mock responses exercise the product
# but are placeholders, not legal analysis. Select exactly one real provider:
# "openai", "anthropic" (Claude) or "gemini".
LITIGATION_LLM_PROVIDER=mock
# LITIGATION_OPENAI_API_KEY=sk-...
# LITIGATION_ANTHROPIC_API_KEY=sk-ant-...
# LITIGATION_GEMINI_API_KEY=...
# Optional provider-specific override. Defaults are gpt-4o-mini,
# claude-sonnet-5 and gemini-3.6-flash respectively.
# LITIGATION_LLM_MODEL=...
LITIGATION_LLM_MAX_OUTPUT_TOKENS=8192

# "auto" uses mock embeddings offline, OpenAI embeddings with OpenAI, Gemini
# Embedding 2 with Gemini, and local BGE-M3 with Claude (Anthropic has no
# embeddings API). The Claude AUTO path requires `.[local-embeddings]`.
LITIGATION_EMBEDDING_PROVIDER=auto
# Optional override. Defaults are text-embedding-3-small (OpenAI),
# gemini-embedding-2 (Gemini), and BAAI/bge-m3 (local/Claude).
# LITIGATION_EMBEDDING_MODEL=...
LITIGATION_GEMINI_EMBEDDING_DIMENSIONS=768
# Pin a Hugging Face commit/tag for reproducible local bake-offs.
# LITIGATION_EMBEDDING_MODEL_REVISION=<commit-sha>
# Optional prefix used only for retrieval queries (model-specific).
# LITIGATION_EMBEDDING_QUERY_INSTRUCTION=Given a legal question, retrieve relevant Brazilian law
# JUÁ example:
# LITIGATION_EMBEDDING_PROVIDER=sentence_transformers
# LITIGATION_EMBEDDING_MODEL=ufca-llms/jua-4B-mixed
# LITIGATION_EMBEDDING_QUERY_INSTRUCTION=Instruct: Given a Brazilian legal search query, retrieve relevant legal passages or documents. Query:
# Optional local inference device, e.g. cpu, cuda or cuda:0.
# LITIGATION_EMBEDDING_DEVICE=cpu
# Keep this small for large legal models such as JUÁ 4B; raise only after
# measuring available CPU/GPU memory.
LITIGATION_EMBEDDING_BATCH_SIZE=8

# Docker build extra. Change to `ocr,local-embeddings` when using Claude with
# AUTO embeddings in Docker. It is ignored by the Python settings object.
LITIGATION_API_EXTRAS=ocr

# --- Storage ---
LITIGATION_DATA_DIR=./data
# Reject PDFs larger than this page count before extraction/OCR.
LITIGATION_MAX_DOCUMENT_PAGES=250
# Raw uploads are deleted after analysis by default. Enable only when a
# documented retention policy requires keeping them.
LITIGATION_RETAIN_UPLOADS=false
# Indexed chunks contain the full document text and are deleted together with
# the job by default. Enable only under an explicit ChromaDB retention policy.
LITIGATION_RETAIN_INDEX=false

# --- RAG ---
# Number of ranked chunks retained per agent query before deduplication and
# context-size filtering. Retrieval audits record the effective value.
LITIGATION_RETRIEVAL_K=6
# Hybrid combines cosine and dependency-free BM25 rankings with deterministic
# reciprocal-rank fusion. Dense remains available for controlled comparisons.
# Business keeps its established dense ranking by default. Consumer legal
# retrieval opts into hybrid explicitly.
LITIGATION_RETRIEVAL_MODE=dense
LITIGATION_RETRIEVAL_CANDIDATE_MULTIPLIER=4
LITIGATION_RETRIEVAL_RRF_CONSTANT=60
LITIGATION_RETRIEVAL_DENSE_WEIGHT=1.0
LITIGATION_RETRIEVAL_LEXICAL_WEIGHT=1.0
# Changing either corpus release or embedding model creates a new Chroma
# collection, preventing incompatible vectors from sharing an index.
LITIGATION_RAG_CORPUS_VERSION=documents-v1
# Optional second stage. Enabling it loads the configured cross-encoder locally.
LITIGATION_RERANKER_PROVIDER=none
LITIGATION_RERANKER_BATCH_SIZE=8
LITIGATION_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
# LITIGATION_RERANKER_MODEL_REVISION=<commit-sha>
# LITIGATION_RERANKER_DEVICE=cpu
# Persisting excerpts expands the sensitive-data footprint. Keep disabled unless
# an explicit access-control and retention policy covers the JSONL run history.
LITIGATION_RETRIEVAL_TRACE_INCLUDE_PREVIEWS=false

# --- Document security ---
# "rules" runs deterministic bilingual checks only. "balanced" (default)
# asks the LLM to classify bounded suspicious excerpts. "strict" reviews all
# page text semantically and can add significant latency/cost.
LITIGATION_PROMPT_INJECTION_SCAN_MODE=balanced
# Strict-mode cost guards. Exceeding either limit fails closed.
LITIGATION_PROMPT_INJECTION_STRICT_MAX_CHARS=500000
LITIGATION_PROMPT_INJECTION_STRICT_MAX_BATCHES=64

# --- DataJud (CNJ public API) ---
# Public key published by CNJ: https://datajud-wiki.cnj.jus.br/api-publica/acesso/
# Sent as header: "Authorization: APIKey <key>"
LITIGATION_DATAJUD_API_KEY=cDZHYzlZa0JadVREZDJCendQbXY6SkJlTzNjLV9TRENyQk1RdnFKZGRQdw==
LITIGATION_DATAJUD_BASE_URL=https://api-publica.datajud.cnj.jus.br

# --- API ---
# Comma-separated list of browser origins allowed by CORS.
LITIGATION_CORS_ALLOW_ORIGINS=http://localhost:8501

# --- Output ---
# Language of the generated report (documents are analyzed in their own language)
LITIGATION_REPORT_LANGUAGE=pt-BR

# --- Logging ---
LITIGATION_LOG_LEVEL=INFO
